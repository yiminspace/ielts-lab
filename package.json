{
  "name": "ielts-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @ielts-lab/web",
    "start": "node services/api/index.mjs",
    "import": "node services/api/import.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc -b",
    "db:migrate": "node services/api/scripts/migrate.mjs",
    "db:import-progress": "node services/api/scripts/import-progress.mjs",
    "test:e2e": "playwright test",
    "export:archive": "node scripts/export-archive.mjs",
    "dev:daily": "node --env-file=.local/learning.env scripts/dev-daily.mjs",
    "test:learning": "uv run --locked --project services/learning pytest -c services/learning/pyproject.toml services/learning/tests"
  },
  "dependencies": {
    "@yiminlab/authkit": "0.3.11",
    "@yiminlab/voyage": "0.18.0",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "apps/web",
    "services/api"
  ]
}
